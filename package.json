{
    "name": "gift-shop",
    "version": "1.0.50",
    "scripts": {
        "start": "bun run build && bun run src/index.tsx",
        "dev": "concurrently 'bun run dev:server' 'bun run dev:scripts'",
        "dev:server": "bun run --watch src/index.tsx",
        "dev:scripts": "bun build ./src/pages/scripts/index.ts --outdir ./src/pages/public/ --watch",
        "build": "bun run build:scripts",
        "build:scripts": "bun build ./src/pages/scripts/index.ts --outdir ./src/pages/public/",
        "db:push": "drizzle-kit push"
    },
    "dependencies": {
        "@elysia/html": "^1.4.1",
        "@elysia/static": "^1.4.11",
        "dotenv": "^17.4.2",
        "drizzle-kit": "1.0.0-rc.4",
        "drizzle-orm": "^1.0.0-rc.4",
        "elysia": "latest"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "bun-types": "latest",
        "concurrently": "^10.0.4",
        "prettier": "^3.9.6"
    },
    "module": "src/index.js"
}
